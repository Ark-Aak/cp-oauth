{
    "name": "cp-oauth",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22 <23"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "upload:s3": "node scripts/upload-oss.mjs",
        "upload:oss": "npm run upload:s3",
        "data:refactor": "node scripts/refactor-data.mjs",
        "postinstall": "nuxt prepare",
        "lint": "eslint . --ignore-pattern generated/**",
        "test:luogu": "node --test tests/luogu-paste.test.mjs",
        "test:unit": "node --test tests/*.test.mjs",
        "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
        "typecheck": "nuxt typecheck",
        "maintenance:oauth": "node scripts/prune-oauth.mjs",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1024.0",
        "@fontsource-variable/source-sans-3": "5.3.0",
        "@element-plus/nuxt": "^1.1.5",
        "@nuxtjs/color-mode": "^4.0.0",
        "@nuxtjs/i18n": "^10.2.3",
        "@prisma/client": "^6.3.0",
        "@shikijs/rehype": "^4.0.2",
        "@simplewebauthn/server": "^13.3.0",
        "bcryptjs": "^3.0.3",
        "chart.js": "^4.5.1",
        "consola": "^3.4.2",
        "dotenv": "^17.4.0",
        "element-plus": "^2.9.1",
        "h3": "^1.15.9",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "lucide-vue-next": "^0.469.0",
        "nodemailer": "^8.0.3",
        "nuxt": "^4.4.2",
        "otplib": "^13.4.0",
        "qrcode": "^1.5.4",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "sanitize-html": "^2.17.2",
        "shiki": "^4.0.2",
        "unified": "^11.0.5",
        "vue": "^3.5.30",
        "vue-router": "^5.0.4",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.15.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/nodemailer": "^7.0.11",
        "@types/qrcode": "^1.5.6",
        "@types/sanitize-html": "^2.16.1",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "ofetch": "^1.5.1",
        "lint-staged": "^15.4.3",
        "prettier": "^3.4.2",
        "prisma": "^6.3.0",
        "sass": "^1.83.4",
        "typescript": "^5.7.3",
        "vue-tsc": "^3.0.0"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,md,css,scss}": [
            "prettier --write"
        ]
    }
}
