# Development infrastructure only (docker compose); set both passwords before starting it.
POSTGRES_USER=cpuser
POSTGRES_PASSWORD=
POSTGRES_DB=cpoauth
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379

# Host-run application: insert the URL-encoded passwords into these localhost URLs.
DATABASE_URL=postgresql://cpuser:@localhost:5432/cpoauth
NUXT_REDIS_URL=redis://:@localhost:6379/0

# Required runtime keys; no deployable secret is supplied here.
# JWT: at least 32 bytes. Existing deployments must preserve the current JWT value.
NUXT_JWT_SECRET=
# Independent encryption key: exactly 32 random bytes, encoded as base64.
NUXT_DATA_ENCRYPTION_KEY=
# Only enable when forwarding client IPs through an explicitly trusted reverse proxy.
NUXT_TRUST_PROXY=false

# Canonical application origin for email, provider callbacks, metadata and cards.
# Production requires HTTPS; local loopback development may use HTTP.
NUXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Empty disables Cloudflare Analytics.
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional host-run Python interpreter after installing requirements.txt in a venv.
# The Docker image sets PYTHON_PATH=/opt/clist-venv/bin/python itself.
# PYTHON_PATH=/absolute/path/to/venv/bin/python

# Optional: CDN base URL for Nuxt built assets (_nuxt)
NUXT_APP_CDN_URL=

# Optional: upload assets only with an explicit npm run upload:s3 (or upload:oss).
S3_UPLOAD_ENABLED=false
S3_REGION=oss-cn-hangzhou
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_SESSION_TOKEN=
S3_PREFIX=
S3_BUILD_DIR=.output/public
S3_UPLOAD_CONCURRENCY=8
S3_FORCE_PATH_STYLE=true

# Legacy aliases remain supported by the upload script when the matching S3 value is empty:
# OSS_UPLOAD_ENABLED, OSS_REGION, OSS_BUCKET, OSS_ACCESS_KEY_ID, OSS_ACCESS_KEY_SECRET,
# OSS_ENDPOINT, OSS_STS_TOKEN, OSS_PREFIX, OSS_BUILD_DIR, OSS_UPLOAD_CONCURRENCY.
